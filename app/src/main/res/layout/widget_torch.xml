<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/torch_widget_button"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="12dp"
    android:background="@drawable/torch_widget_background"
    android:clickable="true"
    android:focusable="true"
    android:contentDescription="Alternar linterna">

    <ImageView
        android:id="@+id/torch_widget_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_flashlight_off"
        android:contentDescription="Linterna" />

    <TextView
        android:id="@+id/torch_widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="ENCENDER"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold" />
</LinearLayout>
